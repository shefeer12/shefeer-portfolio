# -----------------------------------------------------------------------------
# SITE URL & CANONICAL HOST
# -----------------------------------------------------------------------------
# Canonical production site URL used for metadataBase, sitemap, robots, and Open Graph:
NEXT_PUBLIC_SITE_URL=https://shefeer.runs-on.dev

# Search engine verification (e.g. Google Search Console token, leave blank if unset):
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION FOR SHEFEER PORTFOLIO
# -----------------------------------------------------------------------------
# Public Cloud Name for client-side video delivery:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hvs5l0qz

# Private Cloudinary server credentials for signed video uploads:
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# -----------------------------------------------------------------------------
# PRIVATE ADMIN DASHBOARD AUTHENTICATION (/admin)
# -----------------------------------------------------------------------------
# Master password used to access the /admin dashboard:
ADMIN_PASSWORD=your_secure_admin_password_here

# Random 32+ character string used to sign session cookies:
ADMIN_SESSION_SECRET=your_random_32_character_session_secret_here

# -----------------------------------------------------------------------------
# GITHUB AUTO-PUBLISHING & VERCEL DEPLOYMENT
# When configured, uploads in /admin commit directly to your GitHub repository,
# triggering an automatic Vercel production deployment in ~60 seconds.
# -----------------------------------------------------------------------------
# Personal Access Token with repository 'contents:write' permission:
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Repository owner (e.g. your GitHub username):
GITHUB_OWNER=your_github_username

# Repository name:
GITHUB_REPO=shefeer-portfolio

# Deployment branch (default: main):
GITHUB_BRANCH=main
